namespace Civi\Api4 {
    class Result extends \ArrayObject {
        public function first(): array { return []; }
        public function single(): array { return []; }
    }
    class Query {
        public function addSelect(string ...$fields): static { return $this; }
        public function addWhere(string $field, string $op, mixed $value): static { return $this; }
        public function addOrderBy(string $field, string $direction): static { return $this; }
        public function addValue(string $field, mixed $value): static { return $this; }
        public function setValues(array $values): static { return $this; }
        public function setLimit(int $limit): static { return $this; }
        public function execute(): Result { return new Result(); }
    }
    class Contribution extends Query {
        public static function get(bool $checkPermissions = true): self { return new self(); }
        public static function update(bool $checkPermissions = true): self { return new self(); }
    }
    class Payment extends Query {
        public static function get(bool $checkPermissions = true): self { return new self(); }
        public static function create(bool $checkPermissions = true): self { return new self(); }
        public function setNotificationForCompleteOrder(bool $value): self { return $this; }
    }
    class PaymentprocessorWebhook extends Query {
        public static function create(bool $checkPermissions = true): self { return new self(); }
        public static function update(bool $checkPermissions = true): self { return new self(); }
    }
    class PaymentProcessor extends Query {
        public static function get(bool $checkPermissions = true): self { return new self(); }
    }
    class OptionValue extends Query {
        public static function get(bool $checkPermissions = true): self { return new self(); }
    }
}

namespace Civi\Api4\Generic {
    class Result extends \ArrayObject {}
    abstract class AbstractAction {
        public function __construct(string $entityName, string $actionName) {}
        public function setCheckPermissions(bool $checkPermissions): static { return $this; }
        abstract public function _run(Result $result): void;
    }
    abstract class DAOEntity extends \Civi\Api4\Query {
        public static function getEntityName(): string { return ''; }
        public static function get(bool $checkPermissions = true): static { return new static(); }
        public static function create(bool $checkPermissions = true): static { return new static(); }
        public static function update(bool $checkPermissions = true): static { return new static(); }
    }
}
