}

namespace Civi\Checkout {
    interface CheckoutOptionInterface {
        public function getLabel(): string;
        public function getFrontendLabel(): string;
        public function getPaymentMethod(): ?string;
        public function getPaymentProcessorId(): ?int;
        public function startCheckout(CheckoutSession $session): void;
        public function continueCheckout(CheckoutSession $session): void;
    }
    interface AfformCheckoutOptionInterface {
        public function validate(\Civi\Afform\Event\AfformValidateEvent $event): void;
        public function getAfformSettings(bool $testMode): array;
        public function getAfformModule(): ?string;
    }
    class CheckoutSession {
        public function getContributionId(): int { return 0; }
        public function isTestMode(): bool { return false; }
        public function setCheckoutParam(string $key, mixed $value): self { return $this; }
        public function getCheckoutParam(string $key): mixed { return null; }
        public function getLandingUrl(): string { return ''; }
        public function setResponseItem(string $key, mixed $value): self { return $this; }
        public function success(): self { return $this; }
        public function fail(): self { return $this; }
        public function cancel(): self { return $this; }
        public function pending(): self { return $this; }
    }
}

